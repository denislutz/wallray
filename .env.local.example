# Copy to .env.local and fill in real values
# Shared by BE and FE — both read from project root

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ASSESSMENT_MODEL=claude-fable-5
# ANTHROPIC_ASSESSMENT_MODEL=claude-sonnet-5  # ~1/3 the cost of claude-fable-5 — see "Model costs" in AI_ASSESSMENT_REWORK.md
# ANTHROPIC_ASSESSMENT_MODEL=claude-opus-4-8

# ── Database ──────────────────────────────────────────────────────────────────
# Local: SQLite (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./wallray.db
# Prod: postgresql+asyncpg://postgres:<password>@<internal-host>:5432/postgres

# ── Auth — AUTH_SECRET and JWT_SECRET must be the same value ──────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
JWT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=WallRay <reports@wallray.com>

# ── Storage (Hetzner Object Storage) ─────────────────────────────────────────
STORAGE_ENDPOINT_URL=https://nbg1.your-objectstorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=wallray

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Base URLs ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
FE_BASE_URL=http://localhost:3000
BE_BASE_URL=http://localhost:8000
MARKETING_BASE_URL=http://localhost:3000
NEXT_PUBLIC_FE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BE_BASE_URL=http://localhost:8000

# ── Dev flags ─────────────────────────────────────────────────────────────────
DEBUG=true

# ── Photo upload limits — shared between BE and FE ───────────────────────────
NEXT_PUBLIC_PHOTO_MIN_COUNT=1
NEXT_PUBLIC_PHOTO_MAX_COUNT=5
NEXT_PUBLIC_PHOTO_MAX_SIZE_MB=10

# ── Pricing ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_EXPERT_REVIEW_PRICE_EUR=49.00

# ── Free tier ─────────────────────────────────────────────────────────────────
# AI-only report cap per user before payment is required. Expert-role accounts
# (EXPERT_REVIEW_EMAILS) get the higher cap instead. Set both generously in local/test
# environments so e2e test accounts (fe/e2e/fixtures/testUser.ts) never hit the cap.
FREE_TIER_LIMIT=2
FREE_TIER_LIMIT_EXPERT=50

# ── Notifications ─────────────────────────────────────────────────────────────
NEW_USER_NOTIFICATION_EMAIL=

# ── Anti-abuse (Cloudflare Turnstile CAPTCHA) ─────────────────────────────────
# TURNSTILE_SECRET_KEY: leave empty locally — verification is a no-op when unset (same convention
# as RESEND_API_KEY/STRIPE_SECRET_KEY above), and `mise run be-test` reads this same file, so
# setting it here would start enforcing CAPTCHA against test requests that don't send a token.
# Set it only if you want to manually exercise the real verification call via the browser —
# Cloudflare's public "always passes" dummy secret is 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# FE-only, safe to default on — Cloudflare's public "always passes" dummy site key, works on any
# hostname including localhost. Get a real site+secret pair for prod at
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
