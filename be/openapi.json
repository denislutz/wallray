    "/auth/otp/debug": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Debug Otp",
        "description": "E2E-only: returns the last plaintext OTP code sent to `email`.\n\nA 404 no-op whenever `settings.debug` is false \u2014 i.e. always in prod, regardless of who\ncalls it. Only ever used by Playwright's global-setup to drive the real sign-in UI without\nan email inbox; the code is never persisted anywhere else (only bcrypt-hashed in Postgres).",
        "operationId": "debug_otp_auth_otp_debug_get",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
